prefix=/storage/Users/currentUser/AICoding/deps/libssh2-pic
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: libcrypto
Requires.private: libcrypto
Libs: -L${libdir} -lssh2  -L/storage/Users/currentUser/.harmonybrew/lib -lssl -L/storage/Users/currentUser/.harmonybrew/lib -lcrypto -R/storage/Users/currentUser/.harmonybrew/lib 
Libs.private:  -L/storage/Users/currentUser/.harmonybrew/lib -lssl -L/storage/Users/currentUser/.harmonybrew/lib -lcrypto -R/storage/Users/currentUser/.harmonybrew/lib 
Cflags: -I${includedir}
